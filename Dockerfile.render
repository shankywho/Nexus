# Single-container deploy for hosts with no database service (Render free tier).
# Runs FalkorDB (in memory, bound to localhost) and the API together.
# Data is lost on restart; AUTO_SEED reloads the sample company on every boot.
# Build from the repository root: docker build -f Dockerfile.render .
FROM falkordb/falkordb:latest

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    BROWSER=0

WORKDIR /app

COPY api/pyproject.toml api/uv.lock api/.python-version api/
RUN cd api && uv sync --frozen --no-dev --no-install-project

COPY api/nexus_api api/nexus_api
RUN cd api && uv sync --frozen --no-dev

COPY fixtures fixtures
COPY scripts scripts

ENV PATH="/app/api/.venv/bin:${PATH}" \
    PYTHONPATH="/app:/app/api" \
    FALKORDB_HOST=127.0.0.1 \
    FALKORDB_PORT=6379 \
    FALKORDB_SSL=false \
    AUTO_SEED=baseline

RUN mkdir -p /app/api/var /app/var && chmod +x scripts/render-entrypoint.sh
WORKDIR /app/api

EXPOSE 10000
ENTRYPOINT ["sh", "/app/scripts/render-entrypoint.sh"]
