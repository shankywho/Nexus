# --- core ---
MOCK_EXTERNALS=true
NEXUS_ORG_ID=acme
LOG_LEVEL=info

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
GRAPH_COMPANY=nexus_company
GRAPH_TEMPORAL=nexus_temporal
GRAPH_DOCS=nexus_docs
QUERY_TIMEOUT_MS=5000

# --- LLM ---
# Set GROQ_API_KEY (or ANTHROPIC_API_KEY) to answer questions with a model over the live graph.
# Leave all keys empty to use the offline answers built from the graph.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
SEMAPHORE_LIMIT=4
GRAPHITI_TELEMETRY_ENABLED=false

# --- API ---
API_PORT=8000
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=https://nexus-.*\.vercel\.app
# AUTO_SEED=baseline   # seed sample data on startup when the graph is empty (hosts without a shell)

# --- web ---
NEXUS_API_URL=http://localhost:8000

# --- sync simulation ---
SYNC_DEFAULT_INTERVAL_MS=600
