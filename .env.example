# --- core ---
MOCK_EXTERNALS=true
NEXUS_ORG_ID=acme
LOG_LEVEL=info

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_COMPANY=nexus_company
GRAPH_TEMPORAL=nexus_temporal
GRAPH_DOCS=nexus_docs
QUERY_TIMEOUT_MS=5000

# --- LLM (only when MOCK_EXTERNALS=false) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
SEMAPHORE_LIMIT=4
GRAPHITI_TELEMETRY_ENABLED=false

# --- API ---
API_PORT=8000
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000

# --- web (falkordb-browser fork) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-only-change-me
NEXUS_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_FALKOR_HOST=localhost
NEXT_PUBLIC_DEFAULT_FALKOR_PORT=6379

# --- sync simulation ---
SYNC_DEFAULT_INTERVAL_MS=600
