{"id": "evt-0072", "org_id": "acme", "kind": "slack_message", "ts": "2026-09-16T10:18:00Z", "actor": "meera", "channel": "sre-platform", "thread_id": "slack:sre-platform:1758009600", "text": "One OpenTelemetry collector in front of the pipeline would give us one schema and one place to drop noisy series.", "refs": {"service_ids": ["metrics-pipeline"], "decision_id": null, "ticket_id": null, "doc_id": null, "pr_id": null}, "supersedes": null, "reverses": null, "facts": [{"subject": "metrics-pipeline", "predicate": "COLLECTS_VIA", "object": "OpenTelemetry-collector", "valid_at": "2026-09-16T10:18:00Z", "invalid_at": null}]}
